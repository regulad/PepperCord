# If PepperCord should be run in `debug` mode. Uncomment to enable.
# When in debug mode, the bot uses per-guild slash commands instead of globals.
# These deploy instantly, but are slower and not supported at scale.
#PEPPERCORD_DEBUG=
# A list of guilds to limit the bot to, as a comma-separated list of IDs. Not needed if the test bot is only in one environment.
#PEPPERCORD_TESTGUILDS=
# URI to the MongoDB database. The default works for Docker when the mongod container is airgapped
PEPPERCORD_DOCUMENTDB_URI=mongodb://mongo
#PEPPERCORD_DB_NAME=
# Discord token to use when connecting to Discord.
PEPPERCORD_TOKEN=your.token.here
# Prefix to use with message commands. Default is ?.
PEPPERCORD_PREFIX=?
# Website to link to, if this is a detached fork.
PEPPERCORD_WEB=https://regulad.github.io/PepperCord
# Sentry DSN to send errors, logs and command traces to. Defaults to the PepperCord project.
# Set it to your own project's DSN, or to an empty value to only log to stdout.
# Traces sample every command in debug mode and 10% of commands otherwise.
#PEPPERCORD_SENTRY_DSN=
